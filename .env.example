# Copy this file to .env and fill in your key:
#     cp .env.example .env
#
# This is OPTIONAL. With no key set, the pipeline runs its deterministic
# keyword-routing path and every feature still works — guardrails, retrieval,
# scoring, the critic loop, the tests, and the evaluation harness.
#
# With a key set, the routing and reasoning agents use the Claude API and fall
# back to the deterministic path automatically on any failure.
#
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
